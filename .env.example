# All variables may also be set without the C2URL_ prefix; the prefix avoids collisions with other tools.
C2URL_PROJECT_ID=TODO
C2URL_BUCKET_ID=TODO

# OPTIONAL object id prefix. 
# Useful for storing files inside of a folder within a bucket.
C2URL_OBJECT_PREFIX=OPTIONAL

# OPTIONAL the image quality, on a scale from 0 (worst) to 95 (best).
# Defaults to 90.
# https://pillow.readthedocs.io/en/stable/handbook/image-file-formats.html#jpeg-saving
C2URL_JPEG_QUALITY=90

# OPTIONAL URL to return instead of the GCS public URL, for buckets served behind a proxy.
# {bucket} is the bucket id and {object} is the blob name including the object prefix.
C2URL_URL_TEMPLATE=https://bucket-{bucket}-123456789.us-central1.run.app/{object}
